# Generate real values with scripts/init-env.ps1. Do not commit .env.
JWT_KEY=replace-with-random-key-of-at-least-32-bytes
SERVICE_KEY=replace-with-a-different-random-key-of-at-least-32-bytes
POSTGRES_PASSWORD=replace-with-random-hex-password
MSSQL_SA_PASSWORD=ReplaceWithStrongSqlPassword123
MONGO_ROOT_PASSWORD=replace-with-random-hex-password
MONGO_REPORT_PASSWORD=replace-with-random-hex-password
MONGO_AUDIT_PASSWORD=replace-with-random-hex-password
ADMIN_USERNAME=admin
# Only seeds a new empty database; imported users retain their previous passwords.
ADMIN_PASSWORD=replace-with-random-password-of-at-least-12-characters
DATA_VOLUME_PREFIX=climate-phase3
API_PORT=5000
FRONTEND_PORT=4200
BIND_ADDRESS=127.0.0.1
CORS_ORIGINS=http://localhost:4200
